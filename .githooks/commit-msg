#!/bin/sh
# SeaGrid: respinge mesajele de commit care prezintă un instrument AI ca autor sau contribuitor.
# Activat de `make setup` (python -m devtools.bootstrap) prin git config core.hooksPath .githooks
# Testat de devtools/tests/test_commit_msg_hook.py

msg_file="$1"
LC_ALL=C
export LC_ALL

# Liniile de comentariu (#) nu ajung în commit.
body=$(grep -v '^#' "$msg_file")

ai='(claude|anthropic|openai|chatgpt|gpt-?[0-9]|copilot|gemini|codex|cursor|aider|devin|windsurf|codeium|tabnine|cody|codewhisperer|amazon q|llm|\[bot\])'

reject() {
  echo "commit-msg: mesaj respins: $1" >&2
  echo "Regula SeaGrid (AGENTS.md): niciun instrument AI nu apare ca autor sau contribuitor." >&2
  echo "Eliminați linia și reîncercați." >&2
  exit 1
}

# 1. Trailere de autorat care numesc un instrument AI.
printf '%s\n' "$body" | grep -Eiq "^[[:space:]]*(co-authored-by|signed-off-by|assisted-by|generated-by|helped-by|authored-by)[[:space:]]*:.*$ai" \
  && reject "trailer de autorat AI (Co-Authored-By etc.)"

# 2. Linii de tip "Generated with ..." / "Generated by ...".
printf '%s\n' "$body" | grep -Eiq '^[[:space:]]*(\W+[[:space:]]*)?generated (with|by)[[:space:]]' \
  && reject 'linie "Generated with/by"'

# 3. Emoji-ul robot (folosit de unele instrumente în atribuire).
printf '%s\n' "$body" | grep -q "$(printf '\360\237\244\226')" \
  && reject "emoji de atribuire AI"

# 4. Adrese și trailere specifice instrumentelor.
printf '%s\n' "$body" | grep -Eiq '(noreply@anthropic\.com|^[[:space:]]*claude-session[[:space:]]*:)' \
  && reject "adresă/trailer de instrument AI"

# 5. Formulări de autorat ("written by Claude", "created with Copilot").
printf '%s\n' "$body" | grep -Eiq "(written|authored|created|made|co-?authored)[[:space:]]+(by|with)[[:space:]]+$ai" \
  && reject "formulare de autorat AI"

exit 0
