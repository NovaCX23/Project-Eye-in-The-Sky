{
  "$defs": {
    "Alert": {
      "additionalProperties": false,
      "description": "A fused alert for one vessel incident (an AIS vessel, or a radar target with no AIS).",
      "properties": {
        "alert_id": {
          "description": "Deterministic id: hash(mmsi or target, primary type, start)",
          "title": "Alert Id",
          "type": "string"
        },
        "alert_type": {
          "description": "Type of the event that opened the incident",
          "title": "Alert Type",
          "type": "string"
        },
        "created_at": {
          "description": "First now at which the alert was emitted",
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "factors": {
          "items": {
            "$ref": "#/$defs/ScoreFactor"
          },
          "title": "Factors",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/ScorePoint"
          },
          "title": "History",
          "type": "array"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Level",
          "type": "string"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "mmsi": {
          "anyOf": [
            {
              "pattern": "^\\d{9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = radar target with no AIS",
          "title": "Mmsi"
        },
        "nearest_infrastructure": {
          "items": {
            "$ref": "#/$defs/InfraProximity"
          },
          "title": "Nearest Infrastructure",
          "type": "array"
        },
        "recommendation": {
          "anyOf": [
            {
              "$ref": "#/$defs/PatrolRecommendation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "related_mmsis": {
          "items": {
            "type": "string"
          },
          "title": "Related Mmsis",
          "type": "array"
        },
        "risk_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Score",
          "type": "integer"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radar target id when the alert has no AIS vessel",
          "title": "Target Id"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "vessel_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vessel Name"
        }
      },
      "required": [
        "alert_id",
        "alert_type",
        "start_time",
        "created_at",
        "updated_at",
        "lat",
        "lon",
        "risk_score",
        "level",
        "factors",
        "history",
        "explanation",
        "event_ids"
      ],
      "title": "Alert",
      "type": "object"
    },
    "InfraProximity": {
      "additionalProperties": false,
      "properties": {
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "infra_id": {
          "title": "Infra Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "infra_id",
        "name",
        "kind",
        "distance_km"
      ],
      "title": "InfraProximity",
      "type": "object"
    },
    "PatrolRecommendation": {
      "additionalProperties": false,
      "properties": {
        "distance_km": {
          "minimum": 0,
          "title": "Distance Km",
          "type": "number"
        },
        "eta_min": {
          "minimum": 0,
          "title": "Eta Min",
          "type": "number"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "unit_id": {
          "title": "Unit Id",
          "type": "string"
        },
        "unit_name": {
          "title": "Unit Name",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "unit_name",
        "distance_km",
        "eta_min"
      ],
      "title": "PatrolRecommendation",
      "type": "object"
    },
    "RadarPass": {
      "additionalProperties": false,
      "description": "One Sentinel-1 overflight of the area, known from the moment ESA published it.",
      "properties": {
        "acquired_at": {
          "format": "date-time",
          "title": "Acquired At",
          "type": "string"
        },
        "available_at": {
          "description": "ESA processing time: the radar evidence exists from here on",
          "format": "date-time",
          "title": "Available At",
          "type": "string"
        },
        "footprint": {
          "description": "[[lat, lon], ...] of the imaged sea",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Footprint",
          "type": "array"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radar image (PNG), path relative to the repo root",
          "title": "Image"
        },
        "image_bounds": {
          "description": "[[lat_s, lon_w], [lat_n, lon_e]]",
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Image Bounds",
          "type": "array"
        },
        "pass_id": {
          "title": "Pass Id",
          "type": "string"
        },
        "satellite": {
          "title": "Satellite",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/RadarTarget"
          },
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "pass_id",
        "satellite",
        "acquired_at",
        "available_at",
        "footprint"
      ],
      "title": "RadarPass",
      "type": "object"
    },
    "RadarTarget": {
      "additionalProperties": false,
      "description": "A vessel-sized return on one Sentinel-1 image, and what the cross-reference with AIS made of it.",
      "properties": {
        "chip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radar crop, path relative to the repo root",
          "title": "Chip"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "length_m": {
          "description": "Apparent length on the image (sidelobes make it longer)",
          "minimum": 0,
          "title": "Length M",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "match_km": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Match Km"
        },
        "mmsi": {
          "anyOf": [
            {
              "pattern": "^\\d{9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Matched AIS vessel, or the silent one",
          "title": "Mmsi"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "peak_db": {
          "description": "Brightest pixel over the local sea clutter",
          "title": "Peak Db",
          "type": "number"
        },
        "status": {
          "description": "unchecked = no AIS was recorded around the image time, so the target cannot be judged",
          "enum": [
            "matched",
            "dark",
            "dark_uncovered",
            "fixed",
            "coastal",
            "excluded",
            "unchecked"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "vessel_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vessel Name"
        }
      },
      "required": [
        "target_id",
        "lat",
        "lon",
        "length_m",
        "peak_db",
        "status"
      ],
      "title": "RadarTarget",
      "type": "object"
    },
    "ScoreFactor": {
      "additionalProperties": false,
      "description": "One component of the additive score.",
      "properties": {
        "added_at": {
          "description": "The moment (now) at which the factor entered the score",
          "format": "date-time",
          "title": "Added At",
          "type": "string"
        },
        "code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "description": "Template sentence filled with the detector's numbers",
          "title": "Detail",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "points": {
          "title": "Points",
          "type": "integer"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "label",
        "points",
        "detail",
        "added_at"
      ],
      "title": "ScoreFactor",
      "type": "object"
    },
    "ScorePoint": {
      "additionalProperties": false,
      "description": "Alert state at time t; the UI displays it without recomputing anything.",
      "properties": {
        "eta_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eta Min"
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Level",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        },
        "unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Recommended unit at this moment",
          "title": "Unit Id"
        }
      },
      "required": [
        "t",
        "score",
        "level"
      ],
      "title": "ScorePoint",
      "type": "object"
    },
    "SensorEvent": {
      "additionalProperties": false,
      "description": "An event produced by a detector (AIS, acoustic, fibre or satellite radar).",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "end": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = still ongoing at time now",
          "title": "End"
        },
        "event_id": {
          "description": "Deterministic id: hash(source, type, mmsi/sensor, start)",
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Event Type",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "metrics": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "The detector's numbers, used in explanations",
          "title": "Metrics",
          "type": "object"
        },
        "mmsi": {
          "anyOf": [
            {
              "pattern": "^\\d{9}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mmsi"
        },
        "sensor_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sensor Id"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "source": {
          "enum": [
            "ais",
            "acoustic",
            "fibre",
            "sar"
          ],
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Radar target the event is about (source sar)",
          "title": "Target Id"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "source",
        "start",
        "lat",
        "lon",
        "confidence"
      ],
      "title": "SensorEvent",
      "type": "object"
    },
    "TrackPoint": {
      "additionalProperties": false,
      "properties": {
        "cog": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cog"
        },
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "sog": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sog"
        },
        "t": {
          "format": "date-time",
          "title": "T",
          "type": "string"
        }
      },
      "required": [
        "t",
        "lat",
        "lon"
      ],
      "title": "TrackPoint",
      "type": "object"
    },
    "VesselTrack": {
      "additionalProperties": false,
      "properties": {
        "mmsi": {
          "pattern": "^\\d{9}$",
          "title": "Mmsi",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/TrackPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "ship_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ship Type"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "mmsi",
        "points"
      ],
      "title": "VesselTrack",
      "type": "object"
    }
  },
  "$id": "seagrid/Timeline.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The out/timeline.json file, the web UI's only input.",
  "properties": {
    "ais_coverage": {
      "description": "Cells where AIS is actually received, [lat_s, lon_w, lat_n, lon_e]; empty = not measured",
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "title": "Ais Coverage",
      "type": "array"
    },
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "title": "Alerts",
      "type": "array"
    },
    "area_assets": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Folder (relative to the repo root) with the area's infrastructure.geojson and patrol_units.json; None = assets/ (demo scenario)",
      "title": "Area Assets"
    },
    "area_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Real-data area (live mode); None for the demo scenario",
      "title": "Area Name"
    },
    "batch_index": {
      "minimum": 0,
      "title": "Batch Index",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/SensorEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "mode": {
      "description": "live = real AIS recorded right now, wall-clock time",
      "enum": [
        "single",
        "replay",
        "watch",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "now": {
      "description": "Nothing in the file has timestamp > now",
      "format": "date-time",
      "title": "Now",
      "type": "string"
    },
    "radar_passes": {
      "description": "Sentinel-1 passes published by now (real data only)",
      "items": {
        "$ref": "#/$defs/RadarPass"
      },
      "title": "Radar Passes",
      "type": "array"
    },
    "reload_interval_s": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reload Interval S"
    },
    "scenario_start": {
      "format": "date-time",
      "title": "Scenario Start",
      "type": "string"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    },
    "vessels": {
      "items": {
        "$ref": "#/$defs/VesselTrack"
      },
      "title": "Vessels",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "batch_index",
    "scenario_start",
    "now",
    "simulated",
    "vessels",
    "events",
    "alerts"
  ],
  "title": "Timeline",
  "type": "object"
}
