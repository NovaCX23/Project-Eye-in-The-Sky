{
  "$id": "seagrid/SensorEvent.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An event produced by a detector (AIS, acoustic or fibre).",
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = still ongoing at time now",
      "title": "End"
    },
    "event_id": {
      "description": "Deterministic id: hash(source, type, mmsi/sensor, start)",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Event Type",
      "type": "string"
    },
    "lat": {
      "maximum": 90,
      "minimum": -90,
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "maximum": 180,
      "minimum": -180,
      "title": "Lon",
      "type": "number"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "The detector's numbers, used in explanations",
      "title": "Metrics",
      "type": "object"
    },
    "mmsi": {
      "anyOf": [
        {
          "pattern": "^\\d{9}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mmsi"
    },
    "sensor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sensor Id"
    },
    "simulated": {
      "default": false,
      "title": "Simulated",
      "type": "boolean"
    },
    "source": {
      "enum": [
        "ais",
        "acoustic",
        "fibre"
      ],
      "title": "Source",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "source",
    "start",
    "lat",
    "lon",
    "confidence"
  ],
  "title": "SensorEvent",
  "type": "object"
}
